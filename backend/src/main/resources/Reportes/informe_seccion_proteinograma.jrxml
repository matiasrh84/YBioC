<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_seccion_proteinograma"
              pageWidth="595" pageHeight="421" orientation="Landscape"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="0" bottomMargin="0"
              uuid="aa000003-0000-0000-0000-000000000003">

    <!-- Proteinograma (electroforesis de proteínas) en formato tabular.
         Muestra fracciones con % y g/dl. La versión gráfica requiere
         diseño externo en Jaspersoft Studio. -->

    <parameter name="laboratorio"     class="java.lang.String"/>
    <parameter name="paciente"        class="java.lang.String"/>
    <parameter name="protocolo"       class="java.lang.String"/>
    <parameter name="fecha"           class="java.lang.String"/>
    <parameter name="medico"          class="java.lang.String"/>
    <parameter name="logo"            class="java.lang.Object"/>
    <parameter name="membrete"        class="java.lang.Object"/>
    <parameter name="observacion_lab" class="java.lang.String"/>

    <!-- Campo seccion: agrupa por práctica (ej: PROTEINOGRAMA SÉRICO)
         Campo analisis: fracción (Albúmina, Alfa-1, Alfa-2, Beta, Gamma)
         Campo resultado: valor en % (o g/dl si unidad=g/dl)
         Campo unidad: % o g/dl
         Campo referencia: rango de referencia -->
    <field name="seccion"    class="java.lang.String"/>
    <field name="analisis"   class="java.lang.String"/>
    <field name="resultado"  class="java.lang.String"/>
    <field name="unidad"     class="java.lang.String"/>
    <field name="referencia" class="java.lang.String"/>
    <field name="metodo"     class="java.lang.String"/>
    <field name="observacion" class="java.lang.String"/>

    <group name="seccion" keepTogether="true">
        <groupExpression><![CDATA[$F{seccion}]]></groupExpression>
        <groupHeader>
            <band height="30" splitType="Prevent">
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="2" width="555" height="14"
                                   uuid="aa000003-0001-0000-0000-000000000003"/>
                    <textElement><font size="10" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{seccion}]]></textFieldExpression>
                </textField>
                <!-- Cabecera de columnas -->
                <staticText>
                    <reportElement x="0" y="17" width="200" height="11"
                                   uuid="aa000003-0002-0000-0000-000000000003"/>
                    <box><topPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/></box>
                    <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                    <text><![CDATA[Fracción]]></text>
                </staticText>
                <staticText>
                    <reportElement x="200" y="17" width="100" height="11"
                                   uuid="aa000003-0003-0000-0000-000000000003"/>
                    <box><topPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/></box>
                    <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                    <text><![CDATA[Resultado]]></text>
                </staticText>
                <staticText>
                    <reportElement x="300" y="17" width="80" height="11"
                                   uuid="aa000003-0004-0000-0000-000000000003"/>
                    <box><topPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/></box>
                    <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                    <text><![CDATA[Unidad]]></text>
                </staticText>
                <staticText>
                    <reportElement x="380" y="17" width="175" height="11"
                                   uuid="aa000003-0005-0000-0000-000000000003"/>
                    <box><topPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/></box>
                    <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                    <text><![CDATA[Valor de Referencia]]></text>
                </staticText>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="18">
                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="0" y="2" width="555" height="12"
                                   isRemoveLineWhenBlank="true"
                                   uuid="aa000003-0006-0000-0000-000000000003"/>
                    <textElement><font size="8" isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="16" width="555" height="1"
                                   uuid="aa000003-0007-0000-0000-000000000003"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#cccccc"/></graphicElement>
                </line>
            </band>
        </groupFooter>
    </group>

    <background><band splitType="Stretch"/></background>

    <pageHeader>
        <band height="44" splitType="Stretch">
            <image onErrorType="Blank">
                <reportElement x="0" y="0" width="555" height="40"
                               uuid="aa000003-0010-0000-0000-000000000003">
                    <printWhenExpression><![CDATA[$P{membrete} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{membrete}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="400" height="16"
                               uuid="aa000003-0011-0000-0000-000000000003">
                    <printWhenExpression><![CDATA[$P{membrete} == null]]></printWhenExpression>
                </reportElement>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{laboratorio}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="42" width="555" height="1"
                               uuid="aa000003-0012-0000-0000-000000000003"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
        </band>
    </pageHeader>

    <detail>
        <band height="14" splitType="Stretch">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="1" width="198" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000003-0030-0000-0000-000000000003"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{analisis}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="200" y="1" width="98" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000003-0031-0000-0000-000000000003"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{resultado}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="300" y="1" width="78" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000003-0032-0000-0000-000000000003"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{unidad}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="380" y="1" width="175" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000003-0033-0000-0000-000000000003"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{referencia}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <lastPageFooter>
        <band height="20">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="3" width="555" height="15"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000003-0040-0000-0000-000000000003"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{observacion_lab}]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>

</jasperReport>
