<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_seccion_filas"
              pageWidth="595" pageHeight="421" orientation="Landscape"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="0" bottomMargin="0"
              uuid="aa000001-0000-0000-0000-000000000001">

    <!-- ── Parámetros del laboratorio y la orden ── -->
    <parameter name="laboratorio"   class="java.lang.String"/>
    <parameter name="paciente"      class="java.lang.String"/>
    <parameter name="protocolo"     class="java.lang.String"/>
    <parameter name="fecha"         class="java.lang.String"/>
    <parameter name="medico"        class="java.lang.String"/>
    <parameter name="logo"          class="java.lang.Object"/>
    <parameter name="membrete"      class="java.lang.Object"/>
    <parameter name="observacion_lab" class="java.lang.String"/>

    <!-- ── Campos del datasource ── -->
    <field name="seccion"    class="java.lang.String"/>
    <field name="analisis"   class="java.lang.String"/>
    <field name="resultado"  class="java.lang.String"/>
    <field name="unidad"     class="java.lang.String"/>
    <field name="referencia" class="java.lang.String"/>
    <field name="metodo"     class="java.lang.String"/>
    <field name="observacion" class="java.lang.String"/>

    <!-- ── Agrupación por sección (práctica) ── -->
    <group name="seccion" keepTogether="true">
        <groupExpression><![CDATA[$F{seccion}]]></groupExpression>
        <groupHeader>
            <band height="16" splitType="Prevent">
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="2" width="555" height="12"
                                   isRemoveLineWhenBlank="true"
                                   uuid="aa000001-0001-0000-0000-000000000001"/>
                    <textElement><font size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{seccion}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="16">
                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement positionType="Float" x="0" y="2" width="555" height="12"
                                   isRemoveLineWhenBlank="true"
                                   uuid="aa000001-0002-0000-0000-000000000001"/>
                    <textElement><font size="8" isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="14" width="555" height="1"
                                   uuid="aa000001-0003-0000-0000-000000000001"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#cccccc"/></graphicElement>
                </line>
            </band>
        </groupFooter>
    </group>

    <background><band splitType="Stretch"/></background>

    <!-- ── Encabezado de página: membrete o nombre del lab ── -->
    <pageHeader>
        <band height="44" splitType="Stretch">
            <!-- Membrete imagen (cuando está cargado) -->
            <image onErrorType="Blank">
                <reportElement x="0" y="0" width="555" height="40"
                               uuid="aa000001-0010-0000-0000-000000000001">
                    <printWhenExpression><![CDATA[$P{membrete} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{membrete}]]></imageExpression>
            </image>
            <!-- Texto: nombre del laboratorio (cuando no hay membrete) -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="400" height="16"
                               uuid="aa000001-0011-0000-0000-000000000001">
                    <printWhenExpression><![CDATA[$P{membrete} == null]]></printWhenExpression>
                </reportElement>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{laboratorio}]]></textFieldExpression>
            </textField>
            <!-- Línea separadora -->
            <line>
                <reportElement x="0" y="42" width="555" height="1"
                               uuid="aa000001-0012-0000-0000-000000000001"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
        </band>
    </pageHeader>

    <!-- ── Cabecera de columnas ── -->
    <columnHeader>
        <band height="13">
            <staticText>
                <reportElement x="0" y="0" width="200" height="11"
                               uuid="aa000001-0020-0000-0000-000000000001"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[Determinación]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="120" height="11"
                               uuid="aa000001-0021-0000-0000-000000000001"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[Resultado]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="50" height="11"
                               uuid="aa000001-0022-0000-0000-000000000001"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[]]></text>
            </staticText>
            <staticText>
                <reportElement x="370" y="0" width="185" height="11"
                               uuid="aa000001-0023-0000-0000-000000000001"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[Valor de Referencia]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ── Detalle por análisis ── -->
    <detail>
        <band height="24" splitType="Stretch">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" x="6" y="1" width="192" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000001-0030-0000-0000-000000000001"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{analisis}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="200" y="1" width="118" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000001-0031-0000-0000-000000000001"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{resultado}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="320" y="1" width="48" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000001-0032-0000-0000-000000000001"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{unidad}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="370" y="1" width="185" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000001-0033-0000-0000-000000000001"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{referencia}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" x="6" y="13" width="549" height="10"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000001-0034-0000-0000-000000000001"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$F{metodo}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ── Pie de última página: observación del laboratorio ── -->
    <lastPageFooter>
        <band height="20">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="3" width="555" height="15"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000001-0040-0000-0000-000000000001"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{observacion_lab}]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>

</jasperReport>
