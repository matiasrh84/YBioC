<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_seccion_cultivo"
              pageWidth="595" pageHeight="421" orientation="Landscape"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="0" bottomMargin="0"
              uuid="aa000004-0000-0000-0000-000000000004">

    <!-- Cultivos bacteriológicos con antibiograma.
         Layout: sección (microorganismo aislado) → lista de determinaciones/antibióticos
         con resultado S (Sensible) / I (Intermedio) / R (Resistente) o texto libre. -->

    <parameter name="laboratorio"     class="java.lang.String"/>
    <parameter name="paciente"        class="java.lang.String"/>
    <parameter name="protocolo"       class="java.lang.String"/>
    <parameter name="fecha"           class="java.lang.String"/>
    <parameter name="medico"          class="java.lang.String"/>
    <parameter name="logo"            class="java.lang.Object"/>
    <parameter name="membrete"        class="java.lang.Object"/>
    <parameter name="observacion_lab" class="java.lang.String"/>

    <!-- seccion: práctica (ej: UROCULTIVO, HEMOCULTIVO)
         analisis: determinación o antibiótico (ej: E.coli, Ampicilina)
         resultado: resultado (ej: Sensible, Resistente, > 100.000 UFC/ml)
         observacion: observación por sección (ej: Muestra adecuada)
         unidad y referencia no se usan en cultivos pero se incluyen por consistencia -->
    <field name="seccion"    class="java.lang.String"/>
    <field name="analisis"   class="java.lang.String"/>
    <field name="resultado"  class="java.lang.String"/>
    <field name="unidad"     class="java.lang.String"/>
    <field name="referencia" class="java.lang.String"/>
    <field name="metodo"     class="java.lang.String"/>
    <field name="observacion" class="java.lang.String"/>

    <group name="seccion" keepTogether="true">
        <groupExpression><![CDATA[$F{seccion}]]></groupExpression>
        <groupHeader>
            <band height="20" splitType="Prevent">
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="3" width="400" height="14"
                                   uuid="aa000004-0001-0000-0000-000000000004"/>
                    <textElement><font size="10" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{seccion}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="20">
                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="0" y="2" width="555" height="14"
                                   isRemoveLineWhenBlank="true"
                                   uuid="aa000004-0002-0000-0000-000000000004"/>
                    <textElement><font size="8" isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="18" width="555" height="1"
                                   uuid="aa000004-0003-0000-0000-000000000004"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#cccccc"/></graphicElement>
                </line>
            </band>
        </groupFooter>
    </group>

    <background><band splitType="Stretch"/></background>

    <pageHeader>
        <band height="44" splitType="Stretch">
            <image onErrorType="Blank">
                <reportElement x="0" y="0" width="555" height="40"
                               uuid="aa000004-0010-0000-0000-000000000004">
                    <printWhenExpression><![CDATA[$P{membrete} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{membrete}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="400" height="16"
                               uuid="aa000004-0011-0000-0000-000000000004">
                    <printWhenExpression><![CDATA[$P{membrete} == null]]></printWhenExpression>
                </reportElement>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{laboratorio}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="42" width="555" height="1"
                               uuid="aa000004-0012-0000-0000-000000000004"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
        </band>
    </pageHeader>

    <detail>
        <band height="16" splitType="Stretch">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" x="20" y="2" width="290" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000004-0030-0000-0000-000000000004"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{analisis}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="312" y="2" width="243" height="12"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000004-0031-0000-0000-000000000004"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{resultado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <lastPageFooter>
        <band height="20">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="3" width="555" height="15"
                               isRemoveLineWhenBlank="true"
                               uuid="aa000004-0040-0000-0000-000000000004"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{observacion_lab}]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>

</jasperReport>
