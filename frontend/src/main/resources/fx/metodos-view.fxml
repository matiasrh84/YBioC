<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="620.0"
      minWidth="920.0"
      prefHeight="620.0"
      prefWidth="920.0"
      spacing="14.0"
      styleClass="content"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.MetodosFxController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <VBox spacing="6.0">
        <Label styleClass="section-title" text="Metodos"/>
        <Label styleClass="section-subtitle" text="Administracion de metodos para analisis."/>
    </VBox>

    <VBox spacing="10.0" styleClass="editor-panel" VBox.vgrow="ALWAYS">
        <children>
            <TableView fx:id="tablaMetodos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" maxWidth="90.0" minWidth="80.0" prefWidth="80.0" text="ID"/>
                    <TableColumn fx:id="nombreColumn" prefWidth="700.0" text="Metodo"/>
                </columns>
            </TableView>

            <TextField fx:id="txtMetodo" onAction="#agregar" promptText="Metodo"/>

            <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true"/>

            <HBox spacing="8.0">
                <children>
                    <Button maxWidth="Infinity" onAction="#agregar" text="Agregar" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button maxWidth="Infinity" onAction="#salir" styleClass="secondary-button" text="Salir" HBox.hgrow="ALWAYS"/>
                </children>
            </HBox>
        </children>
    </VBox>
</VBox>
