<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0"
      styleClass="content"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.UnidadesFxController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="editor-panel">
        <FontIcon iconLiteral="mdi2m-magnify" iconSize="18" iconColor="#64727d"/>
        <TextField fx:id="filtroField" promptText="Buscar unidad..." HBox.hgrow="ALWAYS" onKeyReleased="#cargar"/>
    </HBox>

    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
        <TableView fx:id="unidadesTable" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nombreColumn" text="Nombre / Sigla"/>
                <TableColumn fx:id="estadoColumn" maxWidth="120.0" minWidth="110.0" prefWidth="110.0" text="Estado"/>
            </columns>
        </TableView>

        <VBox minWidth="300.0" prefWidth="320.0" spacing="10.0" styleClass="editor-panel">
            <Label fx:id="modoLabel" styleClass="modo-label" text="Nueva unidad"/>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="Nombre / Sigla"/>
                <TextField fx:id="nombreField" onAction="#guardar" promptText="mg/dL, UI, g/L..."/>
            </VBox>

            <CheckBox fx:id="estadoCheck" text="Activa"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true"/>

            <HBox spacing="8.0">
                <Button fx:id="cancelarBtn" styleClass="secondary-button" onAction="#cancelar"
                        visible="false" managed="false" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="mdi2c-close" iconSize="16"/></graphic>
                    <text>Cancelar</text>
                </Button>
                <Button fx:id="guardarBtn" onAction="#guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="18" iconColor="white"/></graphic>
                    <text>Agregar</text>
                </Button>
            </HBox>
            <Button maxWidth="Infinity" fx:id="bajaBtn" onAction="#cambiarEstado"
                    styleClass="secondary-button" visible="false" managed="false">
                <graphic><FontIcon iconLiteral="mdi2p-power" iconSize="16"/></graphic>
                <text>Baja / Reactivar</text>
            </Button>
        </VBox>
    </HBox>
</VBox>
