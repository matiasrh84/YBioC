<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0"
      style="-fx-background-color: #f4f7f9;"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.NuevoPacienteFxController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label styleClass="panel-title" text="Alta de Paciente"/>

    <!-- Modo info (visible cuando viene de una persona existente) -->
    <VBox fx:id="seccionDatosPersona" spacing="10.0">
        <Label fx:id="lblModoInfo" text="" wrapText="true"/>
    </VBox>

    <!-- Datos de la persona -->
    <GridPane hgap="12.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label styleClass="field-label" text="Apellido *"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtApellido" promptText="Apellido"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label styleClass="field-label" text="Nombre *"
               GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Nombre"
                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label styleClass="field-label" text="DNI"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDni" promptText="Número de DNI"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <CheckBox fx:id="chkSinDni" text="Sin DNI (recién nacido, etc.)"
                  onAction="#toggleSinDni"
                  GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="2"/>

        <Label styleClass="field-label" text="Nacimiento"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="dpNacimiento" promptText="Fecha de nacimiento"
                    maxWidth="Infinity"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label styleClass="field-label" text="Domicilio"
               GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <TextField fx:id="txtDomicilio" promptText="Domicilio"
                   GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <Label styleClass="field-label" text="Teléfono"
               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtTelefono" promptText="Teléfono"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label styleClass="field-label" text="Mail"
               GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <TextField fx:id="txtMail" promptText="Correo electrónico"
                   GridPane.columnIndex="3" GridPane.rowIndex="3"/>
    </GridPane>

    <Separator/>

    <!-- Obra Social -->
    <GridPane hgap="12.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label styleClass="field-label" text="Obra Social *"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cboObraSocial" promptText="Seleccionar..."
                  maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="3"/>

        <Label styleClass="field-label" text="Nro. Afiliado"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNroAfiliado" promptText="Número de afiliado"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Label fx:id="lblMensaje" styleClass="form-message" wrapText="true"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#cancelar" styleClass="secondary-button" text="Cancelar"/>
        <Button onAction="#guardar" text="Guardar"/>
    </HBox>
</VBox>
