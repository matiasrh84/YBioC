<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="760.0"
      minWidth="1260.0"
      prefHeight="760.0"
      prefWidth="1260.0"
      spacing="18.0"
      style="-fx-background-color: #f4f7f9;"
      styleClass="content"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.MedicosFxController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <!-- Barra de búsqueda -->
    <TextField fx:id="filtroField" promptText="Buscar por apellido, nombre o matricula"/>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <TableView fx:id="medicosTable" prefWidth="760.0" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="matriculaColumn" maxWidth="100.0" minWidth="90.0" prefWidth="90.0" text="Matricula"/>
                <TableColumn fx:id="apellidoColumn" prefWidth="170.0" text="Apellido"/>
                <TableColumn fx:id="nombreColumn" prefWidth="170.0" text="Nombre"/>
                <TableColumn fx:id="mailColumn" prefWidth="220.0" text="Mail"/>
                <TableColumn fx:id="telefonoColumn" prefWidth="140.0" text="Telefono"/>
                <TableColumn fx:id="estadoColumn" maxWidth="100.0" minWidth="90.0" prefWidth="90.0" text="Estado"/>
            </columns>
        </TableView>

        <VBox minWidth="360.0" prefWidth="400.0" spacing="12.0" styleClass="editor-panel">
            <Label styleClass="panel-title" text="Datos del medico"/>

            <GridPane hgap="10.0" vgap="10.0">
                <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label styleClass="field-label" text="Apellido"/>
                    <TextField fx:id="apellidoField" promptText="Apellido"/>
                </VBox>
                <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label styleClass="field-label" text="Nombre"/>
                    <TextField fx:id="nombreField" promptText="Nombre"/>
                </VBox>

                <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label styleClass="field-label" text="Matricula"/>
                    <TextField fx:id="matriculaField" promptText="Matricula"/>
                </VBox>
                <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label styleClass="field-label" text="Telefono"/>
                    <TextField fx:id="telefonoField" promptText="Telefono"/>
                </VBox>

                <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                    <Label styleClass="field-label" text="Mail"/>
                    <TextField fx:id="mailField" promptText="Mail"/>
                </VBox>

                <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                    <Label styleClass="field-label" text="Observaciones"/>
                    <TextArea fx:id="observacionesField" promptText="Observaciones" prefRowCount="3" wrapText="true"/>
                </VBox>
            </GridPane>

            <CheckBox fx:id="estadoCheck" text="Activo"/>

            <!-- Sección especialidades -->
            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Especialidades"/>
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <ComboBox fx:id="especialidadCombo" promptText="Seleccionar especialidad..."
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="−" onAction="#quitarEspecialidad" styleClass="secondary-button"/>
                </HBox>
                <ListView fx:id="especialidadesListView" prefHeight="80.0"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true"/>

            <!-- Fila 1: Nuevo + Guardar -->
            <HBox spacing="8.0">
                <Button onAction="#nuevo" styleClass="secondary-button" text="Nuevo"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button onAction="#guardar" text="Guardar"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <!-- Fila 2: Agregar Especialidad -->
            <Button maxWidth="Infinity" onAction="#agregarEspecialidad" styleClass="secondary-button"
                    text="Agregar Especialidad"/>
            <!-- Fila 3: Baja / Reactivar -->
            <Button maxWidth="Infinity" onAction="#cambiarEstado" styleClass="secondary-button"
                    text="Baja / Reactivar"/>
        </VBox>
    </HBox>
</VBox>
