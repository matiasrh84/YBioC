<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0"
      styleClass="content"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.DerivacionesFxController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="editor-panel">
        <FontIcon iconLiteral="mdi2m-magnify" iconSize="18" iconColor="#64727d"/>
        <TextField fx:id="filtroField" promptText="Buscar por nombre, dirección o mail..." HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
        <TableView fx:id="derivacionesTable" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nombreColumn" prefWidth="200.0" text="Nombre"/>
                <TableColumn fx:id="direccionColumn" prefWidth="200.0" text="Dirección"/>
                <TableColumn fx:id="telefonoColumn" prefWidth="130.0" text="Teléfono"/>
                <TableColumn fx:id="mailColumn" prefWidth="200.0" text="Mail"/>
            </columns>
        </TableView>

        <VBox minWidth="320.0" prefWidth="340.0" spacing="10.0" styleClass="editor-panel">
            <Label fx:id="modoLabel" styleClass="modo-label" text="Nueva derivación"/>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="Nombre *"/>
                <TextField fx:id="nombreField" promptText="Laboratorio"/>
            </VBox>
            <VBox spacing="4.0">
                <Label styleClass="field-label" text="Dirección"/>
                <TextField fx:id="direccionField" promptText="Dirección"/>
            </VBox>
            <VBox spacing="4.0">
                <Label styleClass="field-label" text="Teléfono"/>
                <TextField fx:id="telefonoField" promptText="Numérico"/>
            </VBox>
            <VBox spacing="4.0">
                <Label styleClass="field-label" text="Mail"/>
                <TextField fx:id="mailField" promptText="mail@ejemplo.com"/>
            </VBox>
            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                <Label styleClass="field-label" text="Observaciones"/>
                <TextArea fx:id="observacionesArea" prefRowCount="3" promptText="Observaciones" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <Region VBox.vgrow="NEVER"/>
            <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true"/>
            <HBox spacing="8.0">
                <Button fx:id="cancelarBtn" styleClass="secondary-button" onAction="#cancelar"
                        visible="false" managed="false" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="mdi2c-close" iconSize="16"/></graphic>
                    <text>Cancelar</text>
                </Button>
                <Button fx:id="guardarBtn" onAction="#guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="18" iconColor="white"/></graphic>
                    <text>Agregar</text>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>
