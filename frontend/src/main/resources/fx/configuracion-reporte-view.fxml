<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="0.0" styleClass="content" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ybc.ybioq.fx.controller.ConfiguracionReporteFxController">

    <!-- ══ Área scrollable ══════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="14.0">
                <padding>
                    <Insets bottom="16.0" left="24.0" right="24.0" top="20.0" />
                </padding>

                <!-- ── Campos + Logo/Firma ── -->
                <HBox spacing="20.0">

                    <!-- Columna izquierda: campos del formulario -->
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">

                        <VBox spacing="4.0">
                            <Label styleClass="field-label" text="Nombre del laboratorio *" />
                            <TextField fx:id="nombreField" promptText="Ej: Laboratorio Central" />
                        </VBox>

                        <VBox spacing="4.0">
                            <Label styleClass="field-label" text="Dirección" />
                            <TextField fx:id="direccionField" promptText="Calle, número, ciudad" />
                        </VBox>

                        <GridPane hgap="12.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            </columnConstraints>
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Teléfono" />
                                <TextField fx:id="telefonoField" promptText="Ej: 2954-123456" />
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Mail" />
                                <TextField fx:id="mailField" promptText="lab@ejemplo.com" />
                            </VBox>
                     <rowConstraints>
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>

                        <GridPane hgap="12.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="34.0" />
                            </columnConstraints>
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Formato" />
                                <ComboBox fx:id="formatoCombo" maxWidth="Infinity" promptText="A4 / A5 / A6" />
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Orientación" />
                                <ComboBox fx:id="orientacionCombo" maxWidth="Infinity" promptText="Vertical / Horizontal" />
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Diseño" />
                                <ComboBox fx:id="disenoCombo" maxWidth="Infinity" promptText="Estándar / Compacto" />
                            </VBox>
                     <rowConstraints>
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>

                        <VBox spacing="4.0">
                            <Label styleClass="field-label" text="Observación (pie de página)" />
                            <TextArea fx:id="observacionArea" prefRowCount="3" promptText="Texto que aparece al pie del informe" wrapText="true" />
                        </VBox>

                        <VBox spacing="4.0">
                            <Label styleClass="field-label" text="Observación 2" />
                            <TextField fx:id="observacion2Field" promptText="Texto adicional" />
         
                            <!-- ── Portada ── -->
                         <VBox spacing="10.0" styleClass="editor-panel">
                             <Label styleClass="field-label" text="Portada del informe (opcional)" />
                             <HBox alignment="CENTER_LEFT" spacing="16.0">
                                 <StackPane prefHeight="170.0" prefWidth="120.0" style="-fx-border-color: #c8d0d8; -fx-border-radius: 6; -fx-background-color: #f4f6f8; -fx-background-radius: 6;">
                                     <ImageView fx:id="portadaView" fitHeight="160.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                                     <Label fx:id="sinPortadaLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px; -fx-text-alignment: center;" text="Sin portada&#10;personalizada" />
                                 </StackPane>
                                 <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                     <Button maxWidth="220.0" onAction="#seleccionarPortada">
                                         <graphic>
                                    <FontIcon iconLiteral="mdi2f-file-image-outline" iconSize="16" />
                                 </graphic>
                                         <text>Seleccionar portada</text>
                                     </Button>
                                     <Button fx:id="quitarPortadaBtn" managed="false" maxWidth="220.0" onAction="#quitarPortada" styleClass="secondary-button" visible="false">
                                         <graphic>
                                    <FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="16" />
                                 </graphic>
                                         <text>Quitar portada</text>
                                     </Button>
                                     <Label style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" text="Si se carga una imagen, se usará como primera página. Si no, el sistema genera una portada automática con logo, nombre y datos del paciente." wrapText="true" />
                                     <Label style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" text="Tamaño: A4 (595×842 px) o A5 (420×595 px) a 72 dpi." wrapText="true" />
                                 </VBox>
                             </HBox>
                         </VBox>
                        </VBox>

                    </VBox>

                    <!-- Columna derecha: logo + firma -->
                    <VBox minWidth="240.0" prefWidth="260.0" spacing="10.0" styleClass="editor-panel">

                        <Label styleClass="field-label" text="Logo del laboratorio" />
                        <StackPane prefHeight="160.0" prefWidth="220.0" style="-fx-border-color: #c8d0d8; -fx-border-radius: 6; -fx-background-color: #f4f6f8; -fx-background-radius: 6;">
                            <ImageView fx:id="logoView" fitHeight="150.0" fitWidth="210.0" pickOnBounds="true" preserveRatio="true" />
                            <Label fx:id="sinLogoLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="Sin logo" />
                        </StackPane>
                        <Button maxWidth="Infinity" onAction="#seleccionarLogo">
                            <graphic><FontIcon iconLiteral="mdi2i-image-plus" iconSize="16" /></graphic>
                            <text>Seleccionar imagen</text>
                        </Button>
                        <Button fx:id="quitarLogoBtn" managed="false" maxWidth="Infinity" onAction="#quitarLogo" styleClass="secondary-button" visible="false">
                            <graphic><FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="16" /></graphic>
                            <text>Quitar logo</text>
                        </Button>

                        <Separator />

                        <Label styleClass="field-label" text="Firma del bioquímico" />
                        <StackPane prefHeight="90.0" prefWidth="220.0" style="-fx-border-color: #c8d0d8; -fx-border-radius: 6; -fx-background-color: #f4f6f8; -fx-background-radius: 6;">
                            <ImageView fx:id="firmaView" fitHeight="80.0" fitWidth="210.0" pickOnBounds="true" preserveRatio="true" />
                            <Label fx:id="sinFirmaLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="Sin firma" />
                        </StackPane>
                        <Button maxWidth="Infinity" onAction="#seleccionarFirma">
                            <graphic><FontIcon iconLiteral="mdi2d-draw-pen" iconSize="16" /></graphic>
                            <text>Seleccionar firma</text>
                        </Button>
                        <Button fx:id="quitarFirmaBtn" managed="false" maxWidth="Infinity" onAction="#quitarFirma" styleClass="secondary-button" visible="false">
                            <graphic><FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="16" /></graphic>
                            <text>Quitar firma</text>
                        </Button>

                        <Label prefHeight="41.0" prefWidth="260.0" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-wrap-text: true;" text="La firma aparece al pie del último análisis del informe." />
                    </VBox>

                </HBox>

                <!-- ── Membrete ── -->
                <VBox spacing="10.0" styleClass="editor-panel">
                    <Label styleClass="field-label" text="Membrete (encabezado de cada hoja)" />
                    <HBox alignment="CENTER_LEFT" spacing="16.0">
                        <StackPane prefHeight="75.0" prefWidth="260.0" style="-fx-border-color: #c8d0d8; -fx-border-radius: 6; -fx-background-color: #f4f6f8; -fx-background-radius: 6;">
                            <ImageView fx:id="membreteView" fitHeight="65.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
                            <Label fx:id="sinMembreteLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="Sin membrete personalizado" />
                        </StackPane>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <Button maxWidth="220.0" onAction="#seleccionarMembrete">
                                <graphic><FontIcon iconLiteral="mdi2i-image-area" iconSize="16" /></graphic>
                                <text>Seleccionar membrete</text>
                            </Button>
                            <Button fx:id="quitarMembreteBtn" managed="false" maxWidth="220.0" onAction="#quitarMembrete" styleClass="secondary-button" visible="false">
                                <graphic><FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="16" /></graphic>
                                <text>Quitar membrete</text>
                            </Button>
                            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" text="Si no se carga ninguno, el sistema genera el encabezado con el logo y los datos del laboratorio." wrapText="true" />
                            <Label style="-fx-text-fill: #e05c1a; -fx-font-size: 11px;" text="La imagen debe ser apaisada (ancho ≥ 3× alto). A4: ~595×100 px · A5: ~420×70 px." wrapText="true" />
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>

    <!-- ══ Footer fijo (siempre visible) ════════════════════════════ -->
    <Separator />
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <padding><Insets bottom="14.0" left="24.0" right="24.0" top="10.0" /></padding>
        <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true" HBox.hgrow="ALWAYS" />
        <Button onAction="#verMuestra" styleClass="secondary-button" style="-fx-min-width: 160px;">
            <graphic><FontIcon iconLiteral="mdi2e-eye-outline" iconSize="16"/></graphic>
            <text>Ver muestra PDF</text>
        </Button>
        <Button onAction="#guardar" style="-fx-min-width: 120px;">
            <graphic><FontIcon iconColor="white" iconLiteral="mdi2c-content-save" iconSize="18" /></graphic>
            <text>Guardar</text>
        </Button>
    </HBox>

</VBox>
