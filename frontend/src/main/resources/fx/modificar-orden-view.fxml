<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0"
      style="-fx-background-color: #f4f7f9;"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.ModificarOrdenFxController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label fx:id="lblTitulo" styleClass="panel-title" text="Modificar Orden"/>
    <Label fx:id="lblInfo" text="" wrapText="true"
           style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>

    <GridPane hgap="12.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints minWidth="130.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="130.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label styleClass="field-label" text="N° de Orden"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNumeroOrden" promptText="Número de orden"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label styleClass="field-label" text="Tipo de Orden"
               GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cboTipoOrden" maxWidth="Infinity"
                  GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label styleClass="field-label" text="Médico"
               GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
        <ComboBox fx:id="cboMedico" promptText="Seleccionar médico..." maxWidth="Infinity"
                  GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="4"/>
    </GridPane>

    <Label fx:id="lblMensaje" styleClass="form-message" wrapText="true"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#cancelar" styleClass="secondary-button" text="Cancelar"/>
        <Button onAction="#guardar" text="Guardar cambios"/>
    </HBox>
</VBox>
