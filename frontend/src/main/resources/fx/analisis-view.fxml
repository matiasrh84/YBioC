<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="930.0"
            minWidth="1500.0"
            prefHeight="930.0"
            prefWidth="1500.0"
            styleClass="content"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ybc.ybioq.fx.controller.AnalisisControllerNewFx">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10.0"
              style="-fx-background-color: #005a84; -fx-padding: 10 14 10 14;">
            <children>
                <TextField fx:id="txtPractica"
                           onAction="#actualizarPractica"
                           prefWidth="280.0"
                           promptText="Practica"/>
                <Label style="-fx-text-fill: #d8edf7; -fx-font-size: 12px;"
                       text="Practica seleccionada:"/>
                <Label fx:id="lblPractica"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: 700;"
                       text="-"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCerrar"
                        onAction="#cerrarVentana"
                        styleClass="secondary-button"
                        text="Cerrar"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="210.0"
              spacing="12.0"
              style="-fx-background-color: #004d73; -fx-padding: 16;">
            <children>
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: 700;"
                       text="ANALISIS"/>
                <Label style="-fx-text-fill: #b7d4e5;" text="Configuracion"/>
                <Separator style="-fx-opacity: 0.35;"/>

                <Button fx:id="btnGeneral"
                        maxWidth="Infinity"
                        onAction="#mostrarGeneral"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #005a84; -fx-font-weight: 700;"
                        text="General"/>
                <Button fx:id="btnAnalisis"
                        maxWidth="Infinity"
                        onAction="#mostrarAnalisis"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #005a84; -fx-font-weight: 700;"
                        text="Analisis"/>
                <Button fx:id="btnInforme"
                        maxWidth="Infinity"
                        onAction="#mostrarInforme"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #005a84; -fx-font-weight: 700;"
                        text="Informe"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="btnSalir"
                        maxWidth="Infinity"
                        onAction="#cerrarVentana"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #005a84; -fx-font-weight: 700;"
                        text="Salir"/>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="panelContenedor" style="-fx-background-color: #f4f7f9;">
            <children>
                <VBox fx:id="panelGeneral" spacing="16.0">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                    </padding>
                    <children>
                        <VBox spacing="10.0" styleClass="editor-panel">
                            <children>
                                <Label styleClass="panel-title" text="General"/>
                                <GridPane hgap="12.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="170.0"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="170.0"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="field-label" text="Instrucciones" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <TextArea fx:id="txtInstrucciones"
                                                  prefHeight="74.0"
                                                  promptText="Instrucciones"
                                                  wrapText="true"
                                                  GridPane.columnIndex="1"
                                                  GridPane.columnSpan="3"
                                                  GridPane.rowIndex="0"/>

                                        <Label styleClass="field-label" text="Seccion" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <ComboBox fx:id="cboSeccion"
                                                  maxWidth="Infinity"
                                                  GridPane.columnIndex="1"
                                                  GridPane.rowIndex="1"/>

                                        <Label styleClass="field-label" text="Tipo" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                        <ComboBox fx:id="cboTipo"
                                                  maxWidth="Infinity"
                                                  GridPane.columnIndex="3"
                                                  GridPane.rowIndex="1"/>

                                        <Label styleClass="field-label" text="Tiempo de proceso (dias)" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                        <ComboBox fx:id="cboTiempoProcesamiento"
                                                  maxWidth="Infinity"
                                                  GridPane.columnIndex="1"
                                                  GridPane.rowIndex="2"/>

                                        <Label styleClass="field-label" text="Derivacion" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                        <HBox spacing="8.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                                            <children>
                                                <CheckBox fx:id="swDerivacion" text="Activa"/>
                                                <ComboBox fx:id="cboDerivaciones" HBox.hgrow="ALWAYS"/>
                                                <Button fx:id="btnDerivaciones"
                                                        onAction="#accionDerivaciones"
                                                        styleClass="secondary-button"
                                                        text="Derivaciones"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                            <items>
                                <VBox spacing="10.0" styleClass="editor-panel">
                                    <children>
                                        <Label styleClass="panel-title" text="Arbol de practicas"/>
                                        <TreeView fx:id="arbolPracticas" VBox.vgrow="ALWAYS"/>
                                        <Button fx:id="btnActualizarInformacion"
                                                onAction="#actualizarInformacion"
                                                styleClass="secondary-button"
                                                text="Actualizar informacion"/>
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="editor-panel">
                                    <children>
                                        <Label styleClass="panel-title" text="Prioridad por practica"/>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="Prioridad actual:"/>
                                                <Label fx:id="lblPrioridadGeneral"
                                                       style="-fx-text-fill: #005a84; -fx-font-size: 16px; -fx-font-weight: 700;"
                                                       text="-"/>
                                            </children>
                                        </HBox>
                                        <TableView fx:id="tablaPioridadPractica" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colNombrePrioridad" prefWidth="280.0" text="Nombre"/>
                                                <TableColumn fx:id="colValorPrioridad" prefWidth="160.0" text="Prioridad"/>
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>

                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                            <children>
                                <Button fx:id="btnSiguienteGeneral"
                                        onAction="#siguienteDesdeGeneral"
                                        text="Siguiente"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox fx:id="panelAnalisis" managed="false" spacing="16.0" visible="false">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                    </padding>
                    <children>
                        <VBox prefWidth="620.0" spacing="12.0" styleClass="editor-panel" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="panel-title" text="Analisis"/>
                                <CheckBox fx:id="chkUnSoloMetodo" text="Un solo metodo para todos los parametros"/>

                                <GridPane hgap="10.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="110.0"/>
                                    </columnConstraints>
                                    <children>
                                        <TextField fx:id="txtMetodo" promptText="Metodo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <Button fx:id="btnMetodo"
                                                onAction="#accionMetodo"
                                                styleClass="secondary-button"
                                                text="Metodos"
                                                GridPane.columnIndex="1"
                                                GridPane.rowIndex="0"/>

                                        <TextField fx:id="txtTitulo" promptText="Titulo" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <Button fx:id="btnTitulo"
                                                onAction="#accionTitulo"
                                                styleClass="secondary-button"
                                                text="Titulos"
                                                GridPane.columnIndex="1"
                                                GridPane.rowIndex="1"/>

                                        <TextField fx:id="txtFormatoMesada"
                                                   promptText="Formato de mesada"
                                                   GridPane.columnIndex="0"
                                                   GridPane.columnSpan="2"
                                                   GridPane.rowIndex="2"/>

                                        <TextField fx:id="txtNombreInforme"
                                                   promptText="Nombre en informe"
                                                   GridPane.columnIndex="0"
                                                   GridPane.columnSpan="2"
                                                   GridPane.rowIndex="3"/>
                                    </children>
                                </GridPane>

                                <VBox spacing="10.0" styleClass="editor-panel">
                                    <fx:define>
                                        <ToggleGroup fx:id="grupoTipoResultado"/>
                                    </fx:define>
                                    <children>
                                        <Label styleClass="panel-title" text="Tipo de Resultado"/>

                                        <GridPane hgap="10.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="165.0"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                                <ColumnConstraints minWidth="130.0"/>
                                            </columnConstraints>
                                            <children>
                                                <RadioButton fx:id="radionum"
                                                             onAction="#seleccionarResultadoNumerico"
                                                             selected="true"
                                                             text="Numerico"
                                                             toggleGroup="$grupoTipoResultado"
                                                             GridPane.columnIndex="0"
                                                             GridPane.rowIndex="0"/>
                                                <ComboBox fx:id="cbounidad"
                                                          maxWidth="Infinity"
                                                          promptText="Unidad"
                                                          GridPane.columnIndex="1"
                                                          GridPane.rowIndex="0"/>
                                                <Button fx:id="btnAgregarUnidad"
                                                        onAction="#abrirUnidades"
                                                        styleClass="secondary-button"
                                                        text="Agregar unidad"
                                                        GridPane.columnIndex="2"
                                                        GridPane.rowIndex="0"/>

                                                <RadioButton fx:id="radioposneg"
                                                             onAction="#seleccionarResultadoPosNeg"
                                                             text="Positivo/Negativo"
                                                             toggleGroup="$grupoTipoResultado"
                                                             GridPane.columnIndex="0"
                                                             GridPane.rowIndex="1"/>
                                                <ComboBox fx:id="cboPosneg"
                                                          maxWidth="Infinity"
                                                          GridPane.columnIndex="1"
                                                          GridPane.columnSpan="2"
                                                          GridPane.rowIndex="1"/>

                                                <Button fx:id="btnTipoResultado"
                                                        maxWidth="Infinity"
                                                        onAction="#agregarTipoResultado"
                                                        styleClass="secondary-button"
                                                        text="Tipo de Resultado"
                                                        GridPane.columnIndex="0"
                                                        GridPane.rowIndex="2"/>
                                                <ComboBox fx:id="cboTexto"
                                                          maxWidth="Infinity"
                                                          GridPane.columnIndex="1"
                                                          GridPane.columnSpan="2"
                                                          GridPane.rowIndex="2"/>

                                                <RadioButton fx:id="radioposnegnum"
                                                             onAction="#seleccionarResultadoPosNegNumerico"
                                                             text="+/- y Numerico"
                                                             toggleGroup="$grupoTipoResultado"
                                                             GridPane.columnIndex="0"
                                                             GridPane.rowIndex="3"/>
                                                <ComboBox fx:id="cboUnidadPositivoNegativo"
                                                          maxWidth="Infinity"
                                                          promptText="Unidad"
                                                          GridPane.columnIndex="1"
                                                          GridPane.rowIndex="3"/>
                                                <TextField fx:id="txtPositivoNegativoNumerico"
                                                           promptText="Valor"
                                                           GridPane.columnIndex="2"
                                                           GridPane.rowIndex="3"/>

                                                <CheckBox fx:id="chkFormula"
                                                          onAction="#toggleFormula"
                                                          text="Formula"
                                                          GridPane.columnIndex="0"
                                                          GridPane.rowIndex="4"/>
                                                <Button fx:id="btnCargarFormula"
                                                        onAction="#cargarFormula"
                                                        styleClass="secondary-button"
                                                        text="Cargar formula"
                                                        GridPane.columnIndex="1"
                                                        GridPane.rowIndex="4"/>
                                                <TextField fx:id="txtformula"
                                                           editable="false"
                                                           promptText="Formula seleccionada"
                                                           GridPane.columnIndex="0"
                                                           GridPane.columnSpan="3"
                                                           GridPane.rowIndex="5"/>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <Separator/>

                                <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150.0"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="28.0"/>
                                        <RowConstraints minHeight="28.0"/>
                                        <RowConstraints minHeight="28.0"/>
                                        <RowConstraints vgrow="ALWAYS"/>
                                    </rowConstraints>
                                    <children>
                                        <Label styleClass="field-label" text="Nombre del parametro" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <TextField fx:id="txtNombreParametro"
                                                   promptText="Parametro"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0"/>

                                        <Label styleClass="field-label" text="Unidad" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtUnidad"
                                                   promptText="Unidad"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1"/>

                                        <Label styleClass="field-label" text="Sexo" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                        <ComboBox fx:id="cboSexo4"
                                                  maxWidth="Infinity"
                                                  GridPane.columnIndex="1"
                                                  GridPane.rowIndex="2"/>

                                        <Label styleClass="field-label" text="Valores de referencia" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                        <TextArea fx:id="txtValoresReferencia"
                                                  promptText="Valores de referencia"
                                                  wrapText="true"
                                                  GridPane.columnIndex="1"
                                                  GridPane.rowIndex="3"/>
                                    </children>
                                </GridPane>

                                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnEditarResultados"
                                                onAction="#editarResultados"
                                                styleClass="secondary-button"
                                                text="Editar resultados"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox minWidth="430.0" prefWidth="460.0" spacing="12.0">
                            <VBox spacing="10.0" styleClass="editor-panel" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label styleClass="panel-title" text="Estructura del analisis"/>
                                    <TreeView fx:id="jTree1" VBox.vgrow="ALWAYS"/>
                                </children>
                            </VBox>

                            <VBox spacing="8.0" styleClass="editor-panel">
                                <children>
                                    <Label styleClass="field-label"
                                           text="Seleccione el analisis y modifique la prioridad"/>
                                    <HBox spacing="8.0">
                                        <children>
                                            <Button fx:id="btnSubirPrioridad"
                                                    maxWidth="Infinity"
                                                    onAction="#subirPrioridad"
                                                    styleClass="secondary-button"
                                                    text="Subir"
                                                    HBox.hgrow="ALWAYS"/>
                                            <Button fx:id="btnBajarPrioridad"
                                                    maxWidth="Infinity"
                                                    onAction="#bajarPrioridad"
                                                    styleClass="secondary-button"
                                                    text="Bajar"
                                                    HBox.hgrow="ALWAYS"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <VBox spacing="8.0" styleClass="editor-panel">
                                <children>
                                    <HBox spacing="8.0">
                                        <children>
                                            <Button fx:id="btnAgregar"
                                                    maxWidth="Infinity"
                                                    onAction="#agregarParametro"
                                                    text="Agregar"
                                                    HBox.hgrow="ALWAYS"/>
                                            <Button fx:id="btnBorrar"
                                                    maxWidth="Infinity"
                                                    onAction="#borrarParametro"
                                                    styleClass="secondary-button"
                                                    text="Borrar"
                                                    HBox.hgrow="ALWAYS"/>
                                            <Button fx:id="btnLimpiar"
                                                    maxWidth="Infinity"
                                                    onAction="#limpiarCampos"
                                                    styleClass="secondary-button"
                                                    text="Limpiar"
                                                    HBox.hgrow="ALWAYS"/>
                                        </children>
                                    </HBox>
                                    <Button fx:id="btnGuardar"
                                            maxWidth="Infinity"
                                            onAction="#guardar"
                                            text="Guardar analisis"/>
                                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                        <children>
                                            <Button fx:id="btnSiguienteAnalisis"
                                                    onAction="#siguienteDesdeAnalisis"
                                                    text="Siguiente"/>
                                        </children>
                                    </HBox>
                                    <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true"/>
                                </children>
                            </VBox>
                        </VBox>
                    </children>
                </HBox>

                <VBox fx:id="panelInforme" managed="false" spacing="14.0" visible="false">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label styleClass="panel-title" text="Informe de practica"/>
                                <Label fx:id="lblPracticaInforme"
                                       style="-fx-text-fill: #005a84; -fx-font-size: 18px; -fx-font-weight: 700;"
                                       text="-"/>
                            </children>
                        </HBox>

                        <HBox spacing="18.0" styleClass="editor-panel">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="field-label" text="Seccion:"/>
                                        <Label fx:id="lblSeccionInforme"
                                               style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #b80000;"
                                               text="-"/>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="field-label" text="Prioridad:"/>
                                        <Label fx:id="lblPrioridadInforme"
                                               style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #b80000;"
                                               text="-"/>
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnAgregarTitulo"
                                        onAction="#agregarTitulo"
                                        styleClass="secondary-button"
                                        text="Agregar titulo"/>
                            </children>
                        </HBox>

                        <SplitPane dividerPositions="0.43" VBox.vgrow="ALWAYS">
                            <items>
                                <VBox spacing="10.0" styleClass="editor-panel">
                                    <children>
                                        <Label styleClass="panel-title" text="Titulos"/>
                                        <TableView fx:id="tablaTitulos" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colIdAnalisisTitulo" prefWidth="90.0" text="ID Analisis"/>
                                                <TableColumn fx:id="colIdTitulo" prefWidth="80.0" text="ID Titulo"/>
                                                <TableColumn fx:id="colTitulo" prefWidth="210.0" text="Titulo"/>
                                                <TableColumn fx:id="colAnalisisTitulo" prefWidth="260.0" text="Analisis"/>
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0" styleClass="editor-panel">
                                    <children>
                                        <Label styleClass="panel-title" text="Prioridades"/>
                                        <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
                                            <items>
                                                <TreeView fx:id="treePrioridades"/>
                                                <TableView fx:id="tablaPrioridadesInforme">
                                                    <columns>
                                                        <TableColumn fx:id="colNombrePrioridadInforme" prefWidth="250.0" text="Nombre"/>
                                                        <TableColumn fx:id="colPrioridadInforme" prefWidth="110.0" text="Prioridad"/>
                                                    </columns>
                                                </TableView>
                                            </items>
                                        </SplitPane>
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>

                        <VBox spacing="10.0" styleClass="editor-panel">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnPrincipalInforme"
                                                onAction="#cerrarVentana"
                                                styleClass="secondary-button"
                                                text="Principal"/>
                                        <Button fx:id="btnAtrasInforme"
                                                onAction="#volverAnalisisDesdeInforme"
                                                styleClass="secondary-button"
                                                text="Atras"/>
                                        <Button fx:id="btnPrevisualizarInforme"
                                                onAction="#previsualizarInforme"
                                                text="Previsualizar informe"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnModificarPrioridad"
                                                onAction="#modificarPrioridadInforme"
                                                styleClass="secondary-button"
                                                text="Modificar prioridad"/>
                                        <Button fx:id="btnFinalizarInforme"
                                                onAction="#finalizarProceso"
                                                styleClass="secondary-button"
                                                text="Finalizar"/>
                                    </children>
                                </HBox>
                                <TextArea fx:id="txtPreviewInforme"
                                          editable="false"
                                          prefHeight="150.0"
                                          promptText="Aqui se mostrara la previsualizacion del informe."
                                          wrapText="true"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
