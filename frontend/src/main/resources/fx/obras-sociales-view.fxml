<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox spacing="14.0" styleClass="content" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ybc.ybioq.fx.controller.ObrasSocialesFxController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
    </padding>

    <!-- ====== IZQUIERDA: formulario ====== -->
    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
        <VBox spacing="10.0" style="-fx-padding: 12px;" styleClass="editor-panel">

            <!-- Fila 1: Razón Social | Nombre corto | Código OS -->
            <HBox spacing="8.0">
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Razón Social *" />
                    <TextField fx:id="txtRazonSocial" promptText="Razón social" />
                </VBox>
                <VBox minWidth="185.0" prefWidth="185.0" spacing="3.0">
                    <Label styleClass="field-label" text="Nombre corto" />
                    <TextField fx:id="txtNombre" promptText="Nombre abreviado" />
                </VBox>
                <VBox minWidth="120.0" prefWidth="120.0" spacing="3.0">
                    <Label styleClass="field-label" text="Código OS *" />
                    <TextField fx:id="txtCodigoOs" promptText="Cód. OS" />
                </VBox>
            </HBox>

            <!-- Fila 2: Fecha | CUIT | Cód. Facturación | Dirección -->
            <HBox spacing="8.0">
                <VBox minWidth="150.0" prefWidth="150.0" spacing="3.0">
                    <Label styleClass="field-label" text="Fecha de alta" />
                    <DatePicker fx:id="dpFechaAlta" />
                </VBox>
                <VBox minWidth="130.0" prefWidth="130.0" spacing="3.0">
                    <Label styleClass="field-label" text="CUIT" />
                    <TextField fx:id="txtCuit" promptText="CUIT" />
                </VBox>
                <VBox minWidth="120.0" prefWidth="120.0" spacing="3.0">
                    <Label styleClass="field-label" text="Cód. Facturación" />
                    <TextField fx:id="txtCodigoFacturacion" promptText="Cód. fac." />
                </VBox>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Dirección" />
                    <TextField fx:id="txtDireccion" promptText="Dirección" />
                </VBox>
            </HBox>

            <!-- Fila 3: Teléfono | Email | Mail 2 | Mail 3 (todos crecen por igual excepto tel) -->
            <HBox spacing="8.0">
                <VBox minWidth="130.0" prefWidth="130.0" spacing="3.0">
                    <Label styleClass="field-label" text="Teléfono" />
                    <TextField fx:id="txtTelefono" promptText="Teléfono" />
                </VBox>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Email" />
                    <TextField fx:id="txtEmail" promptText="mail@ejemplo.com" />
                </VBox>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Mail 2" />
                    <TextField fx:id="txtMail1" promptText="Mail 2" />
                </VBox>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Mail 3" />
                    <TextField fx:id="txtMail2" promptText="Mail 3" />
                </VBox>
            </HBox>

            <!-- Fila 4: Sitio web | Referente | Tel. Referente -->
            <HBox spacing="8.0">
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Sitio web" />
                    <TextField fx:id="txtPaginaWeb" promptText="https://..." />
                </VBox>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Referente" />
                    <TextField fx:id="txtReferente" promptText="Nombre referente" />
                </VBox>
                <VBox minWidth="130.0" prefWidth="130.0" spacing="3.0">
                    <Label styleClass="field-label" text="Tel. Referente" />
                    <TextField fx:id="txtTelefonoReferente" promptText="Teléfono" />
                </VBox>
            </HBox>

            <Separator />

            <!-- ====== Parámetros de facturación ====== -->
            <VBox spacing="14.0">
                <Label style="-fx-font-weight: bold;" styleClass="field-label" text="Parámetros de facturación" />

                <!-- Período NBU | Arancel | Porc. afiliado | Porc. descuento -->
                <HBox spacing="8.0">
                    <VBox minWidth="90.0" prefWidth="90.0" spacing="3.0">
                        <Label styleClass="field-label" text="Período NBU" />
                        <TextField fx:id="txtPeriodoNbu" promptText="2026" />
                    </VBox>
                    <VBox minWidth="140.0" prefWidth="140.0" spacing="3.0">
                        <Label styleClass="field-label" text="Arancel ($)" />
                        <TextField fx:id="txtUnidadArancel" promptText="0.00" />
                    </VBox>
                    <VBox minWidth="110.0" prefWidth="110.0" spacing="3.0">
                        <Label styleClass="field-label" text="Porc. afiliado" />
                        <TextField fx:id="txtPorcentajeAfiliado" promptText="0" />
                    </VBox>
                    <VBox minWidth="110.0" prefWidth="110.0" spacing="3.0">
                        <Label styleClass="field-label" text="Porc. descuento" />
                        <TextField fx:id="txtPorcentajeDescuento" promptText="0" />
                    </VBox>
                </HBox>

                <!-- CheckBoxes -->
                <HBox spacing="30.0">
                    <CheckBox fx:id="cbFacturaAltaComplejidad" text="Alta complejidad por separado" />
                    <CheckBox fx:id="cbFacturaNoNomenclados" text="Factura no nomenclados" />
                    <CheckBox fx:id="cbFacturaPorPaciente" text="Factura por paciente" />
                </HBox>
                <HBox spacing="30.0">
                    <CheckBox fx:id="cbSubtotalPorPaciente" text="Subtotal por paciente" />
                    <CheckBox fx:id="cbTieneCategorizacion" text="Tiene categorización" />
                </HBox>

                <!-- RadioButtons horizontales -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label minWidth="130.0" styleClass="field-label" text="Factura por:" />
                    <RadioButton fx:id="rbCupon" text="Cupón">
                  <toggleGroup>
                     <ToggleGroup fx:id="groupFacturaPor" />
                  </toggleGroup></RadioButton>
                    <RadioButton text="Ingreso" toggleGroup="$groupFacturaPor" />
                    <RadioButton text="Orden" toggleGroup="$groupFacturaPor" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label minWidth="130.0" styleClass="field-label" text="Doble informe:" />
                    <RadioButton fx:id="rbNunca" text="Nunca">
                  <toggleGroup>
                     <ToggleGroup fx:id="groupImprimeDobleInforme" />
                  </toggleGroup></RadioButton>
                    <RadioButton text="Siempre" toggleGroup="$groupImprimeDobleInforme" />
                    <RadioButton text="Alta Complejidad" toggleGroup="$groupImprimeDobleInforme" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label minWidth="130.0" styleClass="field-label" text="D998:" />
                    <RadioButton fx:id="rbIncluye" text="Incluye">
                  <toggleGroup>
                     <ToggleGroup fx:id="groupD998" />
                  </toggleGroup></RadioButton>
                    <RadioButton text="No Incluye" toggleGroup="$groupD998" />
                    <RadioButton text="Discrimina" toggleGroup="$groupD998" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label minWidth="130.0" styleClass="field-label" text="Facturación:" />
                    <RadioButton fx:id="rbDirecta" text="Directa">
                  <toggleGroup>
                     <ToggleGroup fx:id="groupTipoFacturacionDirectaColegio" />
                  </toggleGroup></RadioButton>
                    <RadioButton text="Colegio" toggleGroup="$groupTipoFacturacionDirectaColegio" />
                </HBox>

                <!-- Combos tipo facturación + tipo IVA -->
                <HBox spacing="10.0">
                    <VBox spacing="3.0">
                        <Label styleClass="field-label" text="Tipo de facturación" />
                        <ComboBox fx:id="cboTipoFacturacion" prefWidth="200.0" />
                    </VBox>
                    <VBox spacing="3.0">
                        <Label styleClass="field-label" text="Tipo IVA" />
                        <ComboBox fx:id="cboTipoIVA" prefWidth="180.0" />
                    </VBox>
                </HBox>

                <!-- ToggleGroups -->
                <fx:define>
                    <ToggleGroup fx:id="groupFacturaPor" />
                    <ToggleGroup fx:id="groupImprimeDobleInforme" />
                    <ToggleGroup fx:id="groupD998" />
                    <ToggleGroup fx:id="groupTipoFacturacionDirectaColegio" />
                </fx:define>
            </VBox>

        </VBox>
    </VBox>

    <!-- ====== DERECHA: lista + acciones ====== -->
    <VBox minWidth="400.0" prefHeight="408.0" prefWidth="420.0" spacing="8.0">

        <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 8px 12px;" styleClass="editor-panel">
            <FontIcon iconColor="#64727d" iconLiteral="mdi2m-magnify" iconSize="18" />
            <TextField fx:id="filtroField" promptText="Buscar obra social..." HBox.hgrow="ALWAYS" />
        </HBox>

        <TableView fx:id="tablaObrasSociales" prefHeight="340.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" maxWidth="90.0" minWidth="60.0" prefWidth="70.0" text="Código" />
                <TableColumn fx:id="colRazonSocial" text="Razón Social" />
                <TableColumn fx:id="colEstado" maxWidth="80.0" minWidth="60.0" prefWidth="70.0" text="Estado" />
            </columns>
        </TableView>
        <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true" />

        <HBox spacing="8.0">
            <Button fx:id="cancelarBtn" managed="false" maxWidth="Infinity" onAction="#cancelar" styleClass="secondary-button" visible="false" HBox.hgrow="ALWAYS">
                <graphic><FontIcon iconLiteral="mdi2c-close" iconSize="16" /></graphic>
                <text>Cancelar</text>
            </Button>
        </HBox>

        <Label fx:id="modoLabel" styleClass="modo-label" text="Nueva obra social" />
         <Button fx:id="guardarBtn" maxWidth="Infinity" onAction="#guardar">
             <graphic>
            <FontIcon iconColor="white" iconLiteral="mdi2p-plus" iconSize="18" />
         </graphic>
             <text>Agregar</text>
         </Button>
      <HBox.margin>
         <Insets />
      </HBox.margin>
    </VBox>
</HBox>
