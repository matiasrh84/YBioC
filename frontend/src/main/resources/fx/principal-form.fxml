<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ComboBox?>
<BorderPane prefHeight="860.0" prefWidth="1360.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ybc.ybioq.fx.controller.PrincipalFxController">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Menú lateral                                                -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="248.0" spacing="6.0" style="-fx-background-color: #004d73;">
            <children>
                <VBox alignment="CENTER" prefHeight="130.0" style="-fx-background-color: #003a57;">
                    <children>
                        <Label text="YBIOQ" textFill="WHITE">
                            <font><Font name="System Bold" size="30.0"/></font>
                        </Label>
                        <Label text="Sistema de gestion" textFill="#a3d2e8">
                            <font><Font size="13.0"/></font>
                        </Label>
                    </children>
                </VBox>

                <Label text="MENU PRINCIPAL" textFill="#9fc5d5">
                    <font><Font name="System Bold" size="12.0"/></font>
                    <VBox.margin><Insets left="18.0" top="8.0"/></VBox.margin>
                </Label>

                <Button fx:id="btnMenuRecepcion" prefHeight="40.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 0 0 0 18; -fx-font-size: 14px;"
                        text="> Recepcion"/>
                <Button fx:id="btnMenuOrdenes" prefHeight="40.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 0 0 0 18; -fx-font-size: 14px;"
                        text="> Ordenes"/>
                <Button fx:id="btnMenuResultados" prefHeight="40.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 0 0 0 18; -fx-font-size: 14px;"
                        text="> Resultados"/>
                <Button fx:id="btnMenuFacturacion" prefHeight="40.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 0 0 0 18; -fx-font-size: 14px;"
                        text="> Facturacion"/>

                <Separator style="-fx-background-color: #006294; -fx-opacity: 0.4;">
                    <VBox.margin><Insets top="4.0" bottom="2.0"/></VBox.margin>
                </Separator>

                <Label text="CONFIGURACION" textFill="#9fc5d5">
                    <font><Font name="System Bold" size="11.0"/></font>
                    <VBox.margin><Insets left="18.0"/></VBox.margin>
                </Label>

                <Button fx:id="btnAnalisis" prefHeight="36.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8e6f5; -fx-alignment: center-left; -fx-padding: 0 0 0 26; -fx-font-size: 13px;"
                        text="- Analisis"/>
                <Button fx:id="btnMedicos" prefHeight="36.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8e6f5; -fx-alignment: center-left; -fx-padding: 0 0 0 26; -fx-font-size: 13px;"
                        text="- Medicos"/>
                <Button fx:id="btnSecciones" prefHeight="36.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8e6f5; -fx-alignment: center-left; -fx-padding: 0 0 0 26; -fx-font-size: 13px;"
                        text="- Secciones"/>
                <Button fx:id="btnPracticas" prefHeight="36.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8e6f5; -fx-alignment: center-left; -fx-padding: 0 0 0 26; -fx-font-size: 13px;"
                        text="- Practicas"/>
                <Button fx:id="btnObrasSociales" prefHeight="36.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8e6f5; -fx-alignment: center-left; -fx-padding: 0 0 0 26; -fx-font-size: 13px;"
                        text="- Obras Sociales"/>
                <Button fx:id="btnConfigReporte" prefHeight="36.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8e6f5; -fx-alignment: center-left; -fx-padding: 0 0 0 26; -fx-font-size: 13px;"
                        text="- Config. Informe"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator style="-fx-background-color: #006294; -fx-opacity: 0.5;"/>
                <Button fx:id="btnSalir" prefHeight="40.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 0 0 0 18; -fx-font-size: 13px;"
                        text="> Salir"/>
            </children>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Área central                                               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <center>
        <StackPane style="-fx-background-color: #e9edf1;">
            <children>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- PANEL RECEPCIÓN                                  -->
                <!-- ═══════════════════════════════════════════════ -->
                <ScrollPane fx:id="panelRecepcion" fitToHeight="true" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: #e9edf1;">
                    <content>
                        <VBox spacing="10.0">
                            <padding><Insets bottom="16.0" left="24.0" right="24.0" top="16.0"/></padding>

                            <!-- Barra de búsqueda con etiqueta, filtro OS y botón -->
                            <HBox alignment="CENTER_LEFT" spacing="8.0"
                                  style="-fx-background-color: white; -fx-padding: 14 16; -fx-background-radius: 8;">
                                <Label text="Buscar paciente:"
                                       style="-fx-font-weight: 700; -fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtBuscarRecepcion"
                                           promptText="DNI, apellido o nombre..."
                                           style="-fx-font-size: 14px;"
                                           HBox.hgrow="ALWAYS"/>
                                <Label text="Obra Social:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cboFiltroRecepcionOs"
                                          promptText="Todas"
                                          prefWidth="200.0"/>
                                <Button onAction="#ejecutarBusquedaRecepcion" text="Buscar"
                                        style="-fx-font-weight: 700;"/>
                            </HBox>

                            <!-- Tabla resultados -->
                            <TableView fx:id="tablaRecepcion"
                                       fixedCellSize="24.0" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colRecepcionTipo"   text="Tipo"             prefWidth="140.0" minWidth="120.0"/>
                                    <TableColumn fx:id="colRecepcionDni"    text="DNI"              prefWidth="120.0" minWidth="100.0"/>
                                    <TableColumn fx:id="colRecepcionNombre" text="Apellido y Nombre" prefWidth="500.0"/>
                                </columns>
                            </TableView>

                            <!-- Paginación recepción -->
                            <HBox alignment="CENTER" spacing="14.0"
                                  style="-fx-background-color: white; -fx-padding: 8 14; -fx-background-radius: 8;">
                                <Button fx:id="btnRecepcionPrev" onAction="#recepcionPaginaAnterior"
                                        styleClass="secondary-button" text="&lt; Anterior" disable="true"/>
                                <Label fx:id="lblRecepcionPagina" text="Página 1 de 1"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <Button fx:id="btnRecepcionSig" onAction="#recepcionPaginaSiguiente"
                                        styleClass="secondary-button" text="Siguiente &gt;" disable="true"/>
                            </HBox>

                            <!-- Barra de acciones -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0"
                                  style="-fx-background-color: white; -fx-padding: 13 16; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label fx:id="lblInfoRecepcion"
                                       text="Ingrese un DNI o nombre para buscar."
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnRecepcionCrearPersona" onAction="#crearPersona"
                                        styleClass="secondary-button" text="Crear Persona" disable="true"/>
                                <Button fx:id="btnRecepcionDarDeAlta" onAction="#darDeAlta"
                                        styleClass="secondary-button" text="Dar de Alta" disable="true"/>
                                <Button fx:id="btnRecepcionVerOrdenes" onAction="#verOrdenesDelPaciente"
                                        styleClass="secondary-button" text="Ver Ordenes" disable="true"/>
                                <Button fx:id="btnRecepcionNuevaOrden" onAction="#nuevaOrdenDesdeRecepcion"
                                        text="Nueva Orden" disable="true" style="-fx-font-weight: 700;"/>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- PANEL ÓRDENES                                    -->
                <!-- ═══════════════════════════════════════════════ -->
                <ScrollPane fx:id="panelOrdenes" fitToHeight="true" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: #e9edf1;" visible="false">
                    <content>
                        <VBox spacing="10.0" prefHeight="820.0">
                            <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>

                            <!-- Contexto: paciente o titulo -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0"
                                  style="-fx-background-color: white; -fx-padding: 10 14; -fx-background-radius: 8;">
                                <Label fx:id="lblOrdenesContexto"
                                       text="Todas las ordenes"
                                       style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #004d73;"
                                       HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnOrdenesVolver" onAction="#volverARecepcion"
                                        styleClass="secondary-button" text="&lt; Volver" visible="false"/>
                            </HBox>

                            <!-- Filtros órdenes -->
                            <HBox alignment="CENTER_LEFT" spacing="8.0"
                                  style="-fx-background-color: white; -fx-padding: 10 14; -fx-background-radius: 8;">
                                <Label text="Filtrar:"
                                       style="-fx-font-weight: 700; -fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtFiltroOrdenQ"
                                           promptText="Paciente (DNI / nombre) o N° orden"
                                           HBox.hgrow="ALWAYS"/>
                                <Label text="Obra Social:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cboFiltroOrdenOs" promptText="Todas" prefWidth="180.0"/>
                                <Label text="Desde:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <DatePicker fx:id="dpFiltroOrdenDesde" promptText="Desde" prefWidth="140.0"/>
                                <Label text="Hasta:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <DatePicker fx:id="dpFiltroOrdenHasta" promptText="Hasta" prefWidth="140.0"/>
                                <Button onAction="#filtrarOrdenes" text="Filtrar"
                                        style="-fx-font-weight: 700;"/>
                                <Button onAction="#limpiarFiltrosOrdenes" styleClass="secondary-button" text="Limpiar"/>
                            </HBox>

                            <!-- Tabla órdenes -->
                            <TableView fx:id="tablaOrdenes" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colOrdenNumero"   text="N° Orden"    prefWidth="150.0" minWidth="120.0"/>
                                    <TableColumn fx:id="colOrdenPaciente" text="Paciente"    prefWidth="280.0"/>
                                    <TableColumn fx:id="colOrdenOs"       text="Obra Social" prefWidth="210.0"/>
                                    <TableColumn fx:id="colOrdenFecha"    text="Fecha"       prefWidth="160.0"/>
                                    <TableColumn fx:id="colOrdenEstado"   text="Estado"      prefWidth="100.0"/>
                                </columns>
                            </TableView>

                            <!-- Paginación -->
                            <HBox alignment="CENTER" spacing="14.0"
                                  style="-fx-background-color: white; -fx-padding: 8 14; -fx-background-radius: 8;">
                                <Button fx:id="btnOrdenesPrev" onAction="#ordenesPaginaAnterior"
                                        styleClass="secondary-button" text="&lt; Anterior" disable="true"/>
                                <Label fx:id="lblOrdenesPagina" text="Página 1 de 1"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <Button fx:id="btnOrdenesSig" onAction="#ordenesPaginaSiguiente"
                                        styleClass="secondary-button" text="Siguiente &gt;" disable="true"/>
                            </HBox>

                            <!-- Acciones órdenes -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0"
                                  style="-fx-background-color: white; -fx-padding: 13 16; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label fx:id="lblInfoOrdenes" text="Seleccione una orden."
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnOrdenesNuevaOrden" onAction="#nuevaOrdenDesdeOrdenes"
                                        styleClass="secondary-button" text="Nueva Orden"/>
                                <Button fx:id="btnOrdenesModificar" onAction="#modificarOrden"
                                        styleClass="secondary-button" text="Modificar" disable="true"/>
                                <Button fx:id="btnOrdenesInformar" onAction="#informarOrden"
                                        text="Informar" disable="true" style="-fx-font-weight: 700;"/>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- PANEL RESULTADOS                                 -->
                <!-- ═══════════════════════════════════════════════ -->
                <ScrollPane fx:id="panelResultados" fitToHeight="true" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: #e9edf1;" visible="false">
                    <content>
                        <VBox spacing="10.0" prefHeight="820.0">
                            <padding><Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/></padding>

                            <!-- Filtros resultados -->
                            <HBox alignment="CENTER_LEFT" spacing="8.0"
                                  style="-fx-background-color: white; -fx-padding: 10 14; -fx-background-radius: 8;">
                                <Label text="Buscar:"
                                       style="-fx-font-weight: 700; -fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtFiltroResQ"
                                           promptText="Paciente (DNI / nombre) o N° orden"
                                           HBox.hgrow="ALWAYS"/>
                                <Label text="Obra Social:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cboFiltroResOs" promptText="Todas" prefWidth="160.0"/>
                                <Label text="Estado:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cboFiltroResEstado" promptText="Todos" prefWidth="180.0"/>
                                <Label text="Desde:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <DatePicker fx:id="dpFiltroResDesde" promptText="Desde" prefWidth="140.0"/>
                                <Label text="Hasta:"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <DatePicker fx:id="dpFiltroResHasta" promptText="Hasta" prefWidth="140.0"/>
                                <Button onAction="#filtrarResultados" text="Filtrar"
                                        style="-fx-font-weight: 700;"/>
                                <Button onAction="#limpiarFiltrosResultados" styleClass="secondary-button" text="Limpiar"/>
                            </HBox>

                            <!-- Tabla resultados -->
                            <TableView fx:id="tablaResultados" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colResNumero"    text="N° Orden"          prefWidth="150.0" minWidth="120.0"/>
                                    <TableColumn fx:id="colResPaciente"  text="Paciente"          prefWidth="250.0"/>
                                    <TableColumn fx:id="colResOs"        text="Obra Social"       prefWidth="190.0"/>
                                    <TableColumn fx:id="colResFecha"     text="Fecha"             prefWidth="150.0"/>
                                    <TableColumn fx:id="colResEstadoRes" text="Estado Resultados" prefWidth="180.0"/>
                                </columns>
                            </TableView>

                            <!-- Paginación -->
                            <HBox alignment="CENTER" spacing="14.0"
                                  style="-fx-background-color: white; -fx-padding: 8 14; -fx-background-radius: 8;">
                                <Button fx:id="btnResultadosPrev" onAction="#resultadosPaginaAnterior"
                                        styleClass="secondary-button" text="&lt; Anterior" disable="true"/>
                                <Label fx:id="lblResultadosPagina" text="Página 1 de 1"
                                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                <Button fx:id="btnResultadosSig" onAction="#resultadosPaginaSiguiente"
                                        styleClass="secondary-button" text="Siguiente &gt;" disable="true"/>
                            </HBox>

                            <!-- Acciones resultados -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0"
                                  style="-fx-background-color: white; -fx-padding: 13 16; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label fx:id="lblInfoResultados" text="Seleccione una orden para informar."
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnResultadosInformar" onAction="#informarDesdeResultados"
                                        text="Informar Resultados" disable="true" style="-fx-font-weight: 700;"/>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- ─────────────────────────────────────────────── -->
                <!-- PANEL FACTURACIÓN                                -->
                <!-- ─────────────────────────────────────────────── -->
                <ScrollPane fx:id="panelFacturacion" fitToHeight="true" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: #e9edf1;" visible="false">
                    <content>
                        <VBox spacing="16.0">
                            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/></padding>
                            <children>
                                <Label text="Facturacion" textFill="#004d73">
                                    <font><Font name="System Bold" size="26.0"/></font>
                                </Label>

                                <GridPane hgap="10.0" vgap="10.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="140.0"/>
                                        <ColumnConstraints minWidth="140.0"/>
                                        <ColumnConstraints minWidth="120.0"/>
                                        <ColumnConstraints minWidth="120.0"/>
                                        <ColumnConstraints minWidth="170.0"/>
                                    </columnConstraints>
                                    <children>
                                        <TextField fx:id="txtBuscarOrden" promptText="Buscar orden"
                                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <DatePicker fx:id="dcFechaDesde" promptText="Desde"
                                                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                        <DatePicker fx:id="dcFechaHasta" promptText="Hasta"
                                                    GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                        <CheckBox fx:id="chkObrasocial" text="Obra social"
                                                  GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                        <Button fx:id="btnFiltrar" text="Filtrar"
                                                GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                                        <Button fx:id="btnLimpiar" text="Limpiar"
                                                GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                                    </children>
                                </GridPane>

                                <SplitPane dividerPositions="0.56" orientation="VERTICAL" VBox.vgrow="ALWAYS">
                                    <items>
                                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;">
                                            <children>
                                                <Label text="Ordenes"/>
                                                <TableView fx:id="tablaOrdenesFact" prefHeight="220.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn prefWidth="120.0" text="Nro orden"/>
                                                        <TableColumn prefWidth="280.0" text="Paciente"/>
                                                        <TableColumn prefWidth="220.0" text="Obra social"/>
                                                        <TableColumn prefWidth="130.0" text="Fecha"/>
                                                        <TableColumn prefWidth="120.0" text="Total"/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;">
                                            <children>
                                                <Label text="Detalle"/>
                                                <TableView fx:id="tablaDetalle" prefHeight="220.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn prefWidth="120.0" text="Codigo"/>
                                                        <TableColumn prefWidth="380.0" text="Practica"/>
                                                        <TableColumn prefWidth="140.0" text="Importe OS"/>
                                                        <TableColumn prefWidth="140.0" text="Importe part."/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </items>
                                </SplitPane>

                                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;">
                                    <children>
                                        <Label text="Total ordenes:"/>
                                        <Label fx:id="lblTotalOrdenes" text="0"/>
                                        <Separator orientation="VERTICAL"/>
                                        <Label text="Monto total:"/>
                                        <Label fx:id="lblMontoTotalOrdenes" text="\$ 0.00"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnEnviarFacturacion"         text="Enviar facturacion"/>
                                        <Button fx:id="btnDetallePracticasFacturacion" text="Detalle practicas"/>
                                        <Button fx:id="btnImprimirResumen"           text="Imprimir resumen"/>
                                    </children>
                                </HBox>
                                <ProgressBar fx:id="progresoOrdenes" prefHeight="18.0" progress="0.0"/>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>


            </children>
        </StackPane>
    </center>
</BorderPane>
