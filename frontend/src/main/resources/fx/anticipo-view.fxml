<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="360.0"
      minWidth="520.0"
      prefHeight="360.0"
      prefWidth="520.0"
      spacing="14.0"
      styleClass="content"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.AnticipoFxController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <VBox spacing="6.0">
        <Label styleClass="section-title" text="Pago del Anticipo"/>
        <Label styleClass="section-subtitle" text="Registro de anticipo para la orden actual."/>
    </VBox>

    <VBox spacing="10.0" styleClass="editor-panel" VBox.vgrow="ALWAYS">
        <children>
            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Monto del anticipo"/>
                <TextField fx:id="montoField" onAction="#cobrar" promptText="0.00"/>
            </VBox>

            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Numero de orden (opcional)"/>
                <TextField fx:id="ordenField" onAction="#cobrar" promptText="Orden"/>
            </VBox>

            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Observacion"/>
                <TextArea fx:id="observacionArea" prefRowCount="4" promptText="Observacion del pago" wrapText="true"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="mensajeLabel" styleClass="form-message" wrapText="true"/>

            <HBox spacing="8.0">
                <Button maxWidth="Infinity" onAction="#cobrar" text="Cobrar" HBox.hgrow="ALWAYS"/>
                <Button maxWidth="Infinity" onAction="#salir" styleClass="secondary-button" text="Salir" HBox.hgrow="ALWAYS"/>
            </HBox>
        </children>
    </VBox>
</VBox>
