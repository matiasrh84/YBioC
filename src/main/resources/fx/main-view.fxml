<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefHeight="760.0" prefWidth="1180.0" styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ybc.ybioq.fx.controller.MainFxController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="topbar">
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0"/>
            </padding>
            <Label styleClass="app-title" text="YBioC"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2.0">
                <Label fx:id="usuarioLabel" styleClass="user-label"/>
                <Label fx:id="permisosLabel" styleClass="permission-label"/>
            </VBox>
            <Button onAction="#cerrarSesion" styleClass="secondary-button" text="Cerrar sesion"/>
            <Button onAction="#salir" styleClass="secondary-button" text="Salir"/>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="250.0" spacing="6.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="16.0" right="16.0" top="24.0"/>
            </padding>
            <Button maxWidth="Infinity" onAction="#showHome" styleClass="nav-button-selected" text="Inicio"/>
            <Button maxWidth="Infinity" onAction="#showEspecialidades" styleClass="nav-button" text="Especialidades"/>
            <Button maxWidth="Infinity" onAction="#showMedicos" styleClass="nav-button" text="Medicos"/>
            <Button disable="true" maxWidth="Infinity" styleClass="nav-button" text="Pacientes"/>
            <Button disable="true" maxWidth="Infinity" styleClass="nav-button" text="Ordenes"/>
            <Button disable="true" maxWidth="Infinity" styleClass="nav-button" text="Resultados"/>
            <Button disable="true" maxWidth="Infinity" styleClass="nav-button" text="Informes"/>
            <Button disable="true" maxWidth="Infinity" styleClass="nav-button" text="Facturacion"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentStack" styleClass="content-host">
            <VBox fx:id="homeContent" spacing="22.0" styleClass="content">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                </padding>
                <VBox spacing="6.0">
                    <Label styleClass="section-title" text="Panel principal"/>
                    <Label styleClass="section-subtitle" text="Base JavaFX conectada al contexto Spring Boot y a MariaDB."/>
                </VBox>
                <GridPane hgap="14.0" vgap="14.0">
                    <VBox styleClass="metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label styleClass="metric-title" text="Especialidades"/>
                        <Label styleClass="metric-value" text="Disponible"/>
                    </VBox>
                    <VBox styleClass="metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label styleClass="metric-title" text="Medicos"/>
                        <Label styleClass="metric-value" text="Disponible"/>
                    </VBox>
                    <VBox styleClass="metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label styleClass="metric-title" text="Pacientes"/>
                        <Label styleClass="metric-value" text="Migracion pendiente"/>
                    </VBox>
                </GridPane>
                <VBox spacing="10.0" styleClass="work-panel">
                    <Label styleClass="panel-title" text="Convencion de pantallas"/>
                    <Label styleClass="body-text" text="Las nuevas pantallas se nombran por dominio en plural: Especialidades, Medicos, Pacientes. Las acciones internas usan Nuevo, Guardar y Baja/Reactivar." wrapText="true"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
