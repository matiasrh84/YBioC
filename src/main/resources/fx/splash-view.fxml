<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="330.0" prefWidth="520.0" spacing="18.0" styleClass="splash-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ybc.ybioq.fx.controller.SplashFxController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0"/>
    </padding>
    <Region VBox.vgrow="ALWAYS"/>
    <ImageView fitHeight="190.0" fitWidth="340.0" preserveRatio="true">
        <image>
            <Image url="@../Imagenes/ybioc.png"/>
        </image>
    </ImageView>
    <Region VBox.vgrow="ALWAYS"/>
    <VBox maxWidth="430.0" spacing="8.0">
        <Label fx:id="estadoLabel" styleClass="splash-status" text="Iniciando aplicacion"/>
        <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="6.0" progress="0.0"/>
    </VBox>
</VBox>
